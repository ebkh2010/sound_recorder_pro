            <LinearLayout
                android:id="@+id/fqs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/samplerate_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sample rate"
                    android:textSize="@dimen/titr_text_size"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/fqs_radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/veryLowQFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="8000"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/lowQFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="22050"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/normalQFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="44100"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/HighQFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="48000"
                        android:textSize="@dimen/subtitr_text_size" />

                </RadioGroup>

                <!--</LinearLayout>-->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fast_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chanels"
                    android:textSize="@dimen/titr_text_size"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/fch_radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mono (1 Chanel)"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/stereo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stereo (2 chanels)"
                        android:textSize="@dimen/subtitr_text_size" />

                </RadioGroup>


            </LinearLayout>

