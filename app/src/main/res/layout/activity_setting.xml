                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/Mp3Q"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coding Quality"
                    android:textSize="@dimen/titr_text_size"
                    android:textStyle="bold" />


                <RadioGroup
                    android:id="@+id/fcodQ_rg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/mp3Qlow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Low (Fast)"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/mp3Qnormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Normal"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/Mp3Qhigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="High"
                        android:textSize="@dimen/subtitr_text_size" />

                    <RadioButton
                        android:id="@+id/mp3Qbest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Best (Slow)"
                        android:textSize="@dimen/subtitr_text_size" />

